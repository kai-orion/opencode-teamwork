{
  "name": "@sandlada/opencode-teamwork",
  "version": "0.0.1-20260926.a",
  "description": "OpenCode plugin that brings Antigravity-style multi-agent teamwork (/teamwork) to OpenCode: scoping interview, milestone state machine, adversarial verification gates, and a TUI status sidebar.",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-teamwork",
    "teamwork",
    "multi-agent",
    "agent-team",
    "milestones",
    "verification",
    "antigravity",
    "slash-command",
    "coding-agent",
    "ai-agent",
    "developer-tools",
    "tui"
  ],
  "homepage": "https://github.com/kai-orion/opencode-teamwork#readme",
  "bugs": {
    "url": "https://github.com/kai-orion/opencode-teamwork/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kai-orion/opencode-teamwork.git"
  },
  "license": "MIT",
  "author": "Kai Orion & Sandlada",
  "type": "module",
  "exports": {
    "./server": {
      "import": "./dist/server.js"
    },
    "./tui": {
      "import": "./src/tui.ts"
    }
  },
  "files": [
    "dist",
    "src/tui.ts",
    "src/i18n.ts",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "clean": "rm -rf dist",
    "build": "bun run clean && bun build ./src/server.ts --outdir ./dist --target bun --external @opencode-ai/plugin --external effect --external zod",
    "ci:version": "bun scripts/resolve-ci-version.ts",
    "pack:dry-run": "npm pack --dry-run",
    "test": "bun test",
    "smoke:v2": "bun scripts/smoke-v2-lifecycle.ts",
    "test:coverage": "bun test --coverage",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "bun run test && bun run build"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.17.1",
    "effect": "^3.21.2",
    "zod": "^4.1.8"
  },
  "peerDependencies": {
    "@opentui/solid": ">=0.5.8",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opencode/client": "0.0.0-beta-19425",
    "@opencode/plugin": "0.0.0-beta-19425",
    "@opencode/schema": "0.0.0-beta-19425",
    "@opencode/theme": "0.0.0-beta-19425",
    "@opentui/core": "0.5.9",
    "@opentui/solid": "0.5.9",
    "@types/bun": "^1.3.13",
    "@types/semver": "^7.8.0",
    "semver": "^7.8.5",
    "solid-js": "1.9.12",
    "typescript": "^6.0.3"
  },
  "engines": {
    "opencode": ">=0.0.0-beta-0 <0.0.0 || >=1.17.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
